<UserControl x:Class="ConsultNote.QuoteTermsEditor"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel>
        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
            <RadioButton x:Name="RentRadioButton" Content="렌트" Margin="0,0,16,0" />
            <RadioButton x:Name="LeaseRadioButton" Content="리스" />
        </StackPanel>
        <TextBlock Text="캐피탈/렌트사" Foreground="{StaticResource TextMutedBrush}" FontSize="12" />
        <Grid Margin="0,5,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <ComboBox x:Name="CompanyComboBox" IsEditable="False" MinHeight="30" />
            <Button Grid.Column="1" Content="+" ToolTip="렌트사 추가" MinWidth="32" Margin="8,0,0,0"
                    Click="ShowAddCompanyButton_Click" />
        </Grid>
        <Grid x:Name="AddCompanyPanel" Visibility="Collapsed" Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox x:Name="NewCompanyTextBox" MaxLength="120" Padding="8,5" PreviewKeyDown="NewCompanyTextBox_PreviewKeyDown" />
            <Button Grid.Column="1" Content="등록" Margin="8,0,0,0" Padding="10,0" Click="AddCompanyButton_Click" />
            <Button Grid.Column="2" Content="취소" Margin="8,0,0,0" Padding="10,0" Click="CancelAddCompanyButton_Click" />
        </Grid>
    </StackPanel>
</UserControl>
